    "schemas": {
      "LoginRequestDTO": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "senha": {
            "type": "string",
            "nullable": true
          },
          "lembrarUsuario": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "ApiAuth"
    },
    {
      "name": "OrdensServico"
    },
    {
      "name": "Usuarios"
