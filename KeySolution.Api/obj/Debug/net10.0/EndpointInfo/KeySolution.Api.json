          "OrdensServico"
        ],
        "parameters": [
          {
            "name": "Numero",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "Texto",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "FiltroCampo",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "FiltroUsuarioId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "FiltroUsuarioNome",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "StatusId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "StatusIds",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "PageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/ordens-servico/status": {
      "get": {
        "tags": [
          "OrdensServico"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/ordens-servico/{id}": {
      "get": {
        "tags": [
          "OrdensServico"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
